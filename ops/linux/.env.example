APP_NAME="Memoria Familiei"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://family.example.com
APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=memoria_staging
DB_USERNAME=memoria_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=memoria_staging_session
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
MEMORIA_DEMO=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Email delivery is not enabled in this deployment slice.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
